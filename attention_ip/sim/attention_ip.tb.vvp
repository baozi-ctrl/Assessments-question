    %add;
    %vpi_call/w 3 171 "$display", "  TEST COMPLETE : vectors=%0d (PASS vec=%0d FAIL vec=%0d)", S<0,vec4,s32>, v000002646ece18c0_0, v000002646ece2220_0 {1 0 0};
    %vpi_call/w 3 173 "$display", "  output comparisons = %0d  PASS=%0d  FAIL=%0d", v000002646ece1320_0, v000002646ece2400_0, v000002646ece1960_0 {0 0 0};
    %vpi_call/w 3 174 "$display", "==========================================================" {0 0 0};
    %load/vec4 v000002646ece1960_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_11.20, 4;
    %vpi_call/w 3 175 "$display", "RESULT: ALL PASS (Golden Model == RTL)" {0 0 0};
    %jmp T_11.21;
T_11.20 ;
    %vpi_call/w 3 176 "$display", "RESULT: FAIL" {0 0 0};
T_11.21 ;
    %vpi_call/w 3 177 "$finish" {0 0 0};
    %end;
